% Cite the paper these models come from.
%
% The eprint and journal fields are ABSENT rather than set to a placeholder, because BibTeX does
% not read comments: an eprint of {TODO} renders as "arXiv:TODO" in a real bibliography, and a
% note of {TODO journal reference} renders as that. An absent field renders nothing at all, so
% the entry is incomplete in a way a reader can see rather than wrong in a way they cannot.
%
% Once the paper is posted, add:
%   eprint        = {NNNN.NNNNN},
%   archivePrefix = {arXiv},
%   primaryClass  = {hep-ph},
% and the journal reference when there is one.

@article{AssiThaler:continuous,
  author  = {Assi, Beno{\^\i}t and Thaler, Jesse},
  title   = {{Beyond Discrete Variations: Continuous Generator Uncertainties Anchored to Precision QCD}},
  year    = {2026}
}

